# Contact form email (Resend). Copy this file to `.env.local` for local dev and
# set the same variables in your Vercel project settings for production.

# Your Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact messages are delivered. You can use your Cloudflare-forwarded
# address (Cloudflare then forwards it on to your real inbox), e.g. hello@danfalzon.com
CONTACT_TO_EMAIL=

# Verified Resend sender. Use a SENDING SUBDOMAIN so it doesn't clash with the
# Cloudflare Email Routing MX/SPF on your root domain, e.g.
#   "Daniel Falzon <hello@send.danfalzon.com>"
# If left blank, the API falls back to Resend's sandbox sender (onboarding@resend.dev),
# which can only deliver to your own Resend account email until a domain is verified.
CONTACT_FROM_EMAIL=
